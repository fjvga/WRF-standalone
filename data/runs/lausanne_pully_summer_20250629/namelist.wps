&share
 wrf_core = 'ARW',
 max_dom = 4,
 start_date = '2025-06-29_00:00:00','2025-06-29_00:00:00','2025-06-29_00:00:00','2025-06-29_00:00:00',
 end_date   = '2025-07-02_00:00:00','2025-07-02_00:00:00','2025-07-02_00:00:00','2025-07-02_00:00:00',
 interval_seconds = 10800,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         =   1,   1,   2,   3,
 parent_grid_ratio =   1,   3,   3,   3,
 i_parent_start    =   1,  41,  41,  41,
 j_parent_start    =   1,  41,  41,  41,
 e_we              = 121, 121, 121, 121,
 e_sn              = 121, 121, 121, 121,
 geog_data_res     = 'default','default','default','default',
 dx = 9000,
 dy = 9000,
 map_proj  = 'lambert',
 ref_lat   = 46.515,
 ref_lon   = 6.655,
 truelat1  = 46.5,
 truelat2  = 46.5,
 stand_lon = 6.655,
 geog_data_path = '/data/geog',
 opt_geogrid_tbl_path = './',
/

&ungrib
 out_format = 'WPS',
 prefix = './FILE',
/

&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
 opt_metgrid_tbl_path = '/opt/WPS/metgrid/',
/
